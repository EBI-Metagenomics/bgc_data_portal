diff --git a/Dockerfile b/Dockerfile
index cb74442..debc81e 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -11,6 +11,13 @@ RUN apt-get update && apt-get install -y \
     libxrender1 \
     libxext6 \
     libsm6 \
+    curl \
+    && apt-get clean \
+    && rm -rf /var/lib/apt/lists/*
+
+# Install Node.js 20 LTS for frontend build
+RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
+    && apt-get install -y nodejs \
     && apt-get clean \
     && rm -rf /var/lib/apt/lists/*

@@ -23,6 +30,11 @@ RUN pip install --upgrade pip && pip install -r requirements-web.txt

 COPY . .

+# Build the React frontend (outputs to /app/static/dashboard/)
+WORKDIR /app/frontend
+RUN npm ci && npm run build
+WORKDIR /app
+
 EXPOSE 8000
 ENV PYTHONUNBUFFERED=0

