FROM python:3.12-slim

RUN apt-get update && apt-get install -y \
    gcc \
    build-essential \
    python3-dev \
    libffi-dev \
    libssl-dev \
    make \
    git \
    curl \
    unzip \
    libxrender1 \
    libxext6 \
    libsm6 \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# ── Dependencies (web stack + science packages, one resolved lock) ──────────
COPY requirements-worker.lock .
RUN pip install --upgrade pip && pip install -r requirements-worker.lock

# ── Application code (changes often) ────────────────────────────────────────
COPY . .
