FROM python:3.12-slim

RUN apt-get update && apt-get install -y \
    gcc \
    build-essential \
    python3-dev \
    libffi-dev \
    libssl-dev \
    make \
    git \
    curl \
    unzip \
    libxrender1 \
    libxext6 \
    libsm6 \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# ChemOnt ontology for chemical-structure similarity search. The chemical
# query task and the ChemOnt IC precompute both run in this worker. Baked in
# at build time (same source as the ETL image) at the default path expected by
# common_core.chemont.ontology. ``/data/<subdir>`` volume mounts don't shadow
# this, so no PVC/mount is needed.
RUN mkdir -p /data/chemont \
 && curl -fsSL -o /tmp/ChemOnt_2_1.obo.zip \
      "http://classyfire.wishartlab.com/system/downloads/1_0/chemont/ChemOnt_2_1.obo.zip" \
 && unzip /tmp/ChemOnt_2_1.obo.zip -d /data/chemont/ \
 && rm /tmp/ChemOnt_2_1.obo.zip
ENV CHEMONT_OBO_PATH=/data/chemont/ChemOnt_2_1.obo

WORKDIR /app

# ── Layer A: heavy ML packages (rarely change → maximise cache) ─────────────
COPY requirements-ml.txt .
RUN pip install --upgrade pip && pip install -r requirements-ml.txt

# ── Layer B: remaining deps ──────────────────────────────────────────────────
COPY requirements-web.txt requirements-worker.txt ./
RUN pip install -r requirements-worker.txt

# ── Layer C: application code (changes often) ───────────────────────────────
COPY . .
