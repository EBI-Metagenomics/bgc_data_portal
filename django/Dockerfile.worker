FROM python:3.12-slim

RUN apt-get update && apt-get install -y \
    gcc \
    build-essential \
    python3-dev \
    libffi-dev \
    libssl-dev \
    make \
    git \
    curl \
    unzip \
    libxrender1 \
    libxext6 \
    libsm6 \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# ChemOnt ontology for chemical-structure similarity search. The chemical
# query task and the ChemOnt IC precompute both run in this worker. Baked in
# at build time (same source as the ETL image) at the default path expected by
# common_core.chemont.ontology. ``/data/<subdir>`` volume mounts don't shadow
# this, so no PVC/mount is needed. Vendored in-repo (vendor/chemont/) rather than
# fetched from classyfire.wishartlab.com, which is frequently unreachable.
# ChemOnt is a static ontology (data-version 2.1, 2016), so it never goes stale.
RUN mkdir -p /data/chemont
COPY vendor/chemont/ChemOnt_2_1.obo /data/chemont/ChemOnt_2_1.obo
ENV CHEMONT_OBO_PATH=/data/chemont/ChemOnt_2_1.obo

WORKDIR /app

# ── Layer A: heavy ML packages (rarely change → maximise cache) ─────────────
COPY requirements-ml.lock .
RUN pip install --upgrade pip && pip install -r requirements-ml.lock

# ── Layer B: remaining deps (full resolved set; ML already satisfied) ────────
COPY requirements-worker.lock .
RUN pip install -r requirements-worker.lock

# ── Layer C: application code (changes often) ───────────────────────────────
COPY . .
